# GitHub token for build-time stats + live API on Vercel (public repo read is enough for stats).
# For shared hub star/download counters, the token also needs gist write access
# (classic: "gist" scope, or fine-grained: Gists read/write).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: reuse an existing private gist for hub engagement counters
# HUB_ENGAGEMENT_GIST_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contact form — pick ONE provider:

# Option A (recommended): Web3Forms — free at https://web3forms.com
# Public key; embedded at build time for the Contact form (browser-side submit).
VITE_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Option B: Resend — https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=nRnWorld Contact <noreply@nrnworld.one>

CONTACT_EMAIL=bynrnworld@gmail.com

# Optional: used by local dev if GITHUB_TOKEN is not set
# VITE_GITHUB_TOKEN=
